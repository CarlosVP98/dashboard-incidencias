<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Identificación del proyecto -->
    <groupId>es.dam.di</groupId>
    <artifactId>dashboard-incidencias</artifactId>
    <version>1.0</version>
    <name>Dashboard de gestión de incidencias</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Versión de Java con la que se compila (JavaFX 27 necesita JDK 24 o superior) -->
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Versión de JavaFX: Maven la descarga automáticamente -->
        <javafx.version>27</javafx.version>
    </properties>

    <dependencies>
        <!-- Controles de JavaFX: Button, Label, TableView, layouts... -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- Soporte para FXML (FXMLLoader, @FXML...) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compilador de Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>

            <!-- Plugin de JavaFX: permite ejecutar la app con "mvn javafx:run" -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>es.dam.di.incidencias.App</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
